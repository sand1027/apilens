{
  "swagger": "2.0",
  "info": { "title": "Legacy Orders API", "version": "1.0" },
  "host": "localhost:5000",
  "basePath": "/",
  "paths": {
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "tags": ["orders"],
        "responses": {
          "200": { "description": "A list of orders" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "tags": ["orders"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": {
          "200": { "description": "A single order" }
        }
      }
    }
  }
}
